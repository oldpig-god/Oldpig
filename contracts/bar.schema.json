{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-workbench:normalized-bar:1",
  "title": "Validated normalized OHLCV bar, schema draft v1",
  "description": "Cross-field OHLC, session membership and finite-number checks also required. Unknown upstream volume units must be quarantined before creating this record. Quotes without complete OHLC use a separate contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instrument_id", "interval", "bar_end", "trade_date", "timezone", "adjustment", "open", "high", "low", "close", "volume", "volume_unit", "amount", "currency", "provider", "upstream", "fetched_at", "available_at", "batch_id", "revision_id", "quality_flags", "data_mode"],
  "properties": {
    "schema_version": {"const": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "interval": {"enum": ["1m", "5m", "15m", "30m", "60m", "1d"]},
    "bar_end": {"type": "string", "format": "date-time", "description": "Canonical event time for this closed bar; provider start labels converted only when semantics are known"},
    "trade_date": {"type": "string", "format": "date"},
    "timezone": {"const": "Asia/Shanghai"},
    "adjustment": {"enum": ["raw", "qfq", "hfq"]},
    "adjustment_version": {"type": ["string", "null"]},
    "open": {"type": "number", "exclusiveMinimum": 0},
    "high": {"type": "number", "exclusiveMinimum": 0},
    "low": {"type": "number", "exclusiveMinimum": 0},
    "close": {"type": "number", "exclusiveMinimum": 0},
    "volume": {"type": "number", "minimum": 0},
    "volume_unit": {"enum": ["share", "fund_unit"]},
    "amount": {"type": "number", "minimum": 0},
    "currency": {"const": "CNY"},
    "provider": {"type": "string", "minLength": 1},
    "upstream": {"type": "string", "minLength": 1},
    "source_published_at": {"type": ["string", "null"], "format": "date-time"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "batch_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "data_mode": {"enum": ["live", "delayed", "historical", "demo"]}
  },
  "allOf": [{"if": {"properties": {"adjustment": {"enum": ["qfq", "hfq"]}}}, "then": {"required": ["adjustment_version"], "properties": {"adjustment_version": {"type": "string", "minLength": 1}}}}]
}
